# 首次只用公网 IP 测试时保持 :80；绑定域名后改为实际域名，例如 speech.example.com
SITE_ADDRESS=:80

SFA_JOBS_DIR=/data/jobs
SFA_AUTH_DB=/data/auth.db

# 只有域名已启用 HTTPS 后才能改为 true
SFA_SECURE_COOKIES=false
SFA_ENABLE_DOCS=false
SFA_CHROME_NO_SANDBOX=true

# 2核2G服务器的保守限制
SFA_WORKERS=1
SFA_MAX_UPLOAD_MB=100
SFA_MAX_DURATION_SECONDS=600
SFA_WHISPER_MODEL=tiny.en
